# ==============================================================================
# SolarSense AI — Streamlit Secrets Configuration Template
# ==============================================================================
# Copy this file to .streamlit/secrets.toml and fill in your Supabase credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .streamlit/secrets.toml file to version control.
# 2. Use ONLY the "anon" / "public" client key in Streamlit frontend applications.
# 3. NEVER use or paste your "service_role" secret key here!
#
# HOW TO OBTAIN YOUR SUPABASE CREDENTIALS:
# 1. Log in to your Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your Project (or create a new free tier project).
# 3. Go to Project Settings -> API.
# 4. Under "Project URL", copy the URL (e.g., https://xyzcompany.supabase.co).
# 5. Under "Project API Keys", copy the "anon" / "public" key.
# 6. In Authentication -> URL Configuration, set your Site URL to:
#    http://localhost:8501 (or your production domain).
# 7. In Authentication -> URL Configuration, add Redirect URLs:
#    http://localhost:8501/?page=login
#    http://localhost:8501/?page=reset_password
# ==============================================================================

[supabase]
url = "https://your-project-id.supabase.co"
key = "your-anon-publishable-key-here"
